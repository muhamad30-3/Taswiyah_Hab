{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm --dir lib/db exec tsc -p tsconfig.json && pnpm --dir artifacts/api-server run build"
  },
  "deploy": {
    "startCommand": "pnpm --dir artifacts/api-server run start",
    "healthcheckPath": "/api/healthz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
